{
  "buildCommand": "VERCEL_TOKEN_CLEAN=\"$(printf '%s' \"${VERCEL_TOKEN}\" | tr -d '\\r\\n')\" && export VERCEL_TOKEN=\"$VERCEL_TOKEN_CLEAN\" && next build",
  "alias": ["ag-contracts.vercel.app"],
  "crons": [
    {
      "path": "/api/cron/renew-subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/slack-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/poll-ingest",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/events/reprocess",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-briefing",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/billing-dunning",
      "schedule": "0 7 * * *"
    }
  ]
}
