# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OAuth tokens
.data/
.env*.local

# SWC plugin cache (build artifact)
.swc/

# Claude Code local config — may contain API keys in permission rules.
# Protected by the global gitignore on Michael's machine only; pin it here
# so the protection travels with the repo.
.claude/settings.local.json
.mcp.local.json
